<limb:LimbTargettingUI
    xmlns="https://spacestation14.io"
    xmlns:limb="clr-namespace:Content.Client._FarHorizons.LimbDamage.UI"
    MinSize="120 170"
    MaxSize="140 190"
    Visible="False">
    <PanelContainer StyleClasses="BorderedWindowPanel">
        <BoxContainer Orientation="Vertical" Margin="4" SeparationOverride="2">
            <Label Text="{Loc 'limb-damage-target-title'}" />
            <Label Name="CurrentTargetLabel" StyleClasses="LabelSubText" />
            <limb:LimbTargettingDisplay Name="LimbTargettingDisplay" SetSize="100 100" />
            <Button Name="RandomButton" Text="{Loc 'limb-damage-target-random'}" />
        </BoxContainer>
    </PanelContainer>
</limb:LimbTargettingUI>
