<ui:ZpmConsoleWindow xmlns="https://spacestation14.io"
                     xmlns:ui="clr-namespace:Content.Client._PV.Zpm"
                     MinSize="900 580"
                     SetSize="1080 660"
                     Title="ZPM Reactor Control">
    <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="10">
        <Label Name="ConnectionLabel" StyleClasses="LabelHeading" Text="No ZPM control linked" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="10" VerticalExpand="True">
            <PanelContainer SetWidth="275" VerticalExpand="True">
                <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="8">
                    <Label Text="OUTPUT SETTING" StyleClasses="LabelHeading" />
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8" VerticalExpand="True">
                        <BoxContainer Orientation="Vertical" SeparationOverride="4" VerticalAlignment="Center">
                            <Label Text="100%" HorizontalAlignment="Center" />
                            <ui:ZpmVerticalBar Name="OutputBar"
                                               MinValue="0" MaxValue="100" Value="0"
                                               Step="5" Interactive="True"
                                               SetWidth="28" SetHeight="285" />
                            <Label Text="0%" HorizontalAlignment="Center" />
                        </BoxContainer>
                        <BoxContainer Orientation="Vertical" SeparationOverride="5" HorizontalExpand="True">
                            <Label Text="STATUS" StyleClasses="LabelHeading" />
                            <PanelContainer StyleClasses="BackgroundPanelDark">
                                <BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="7">
                                    <Label Name="CoreLabel" Text="Core: --" />
                                    <Label Name="ConditionLabel" Text="Condition: --" />
                                    <Label Name="IntegrityLabel" Text="Integrity: --" />
                                    <Label Name="ShieldingLabel" Text="Shielding: --" />
                                    <Label Name="VacuumLabel" Text="Chamber pressure: --" />
                                </BoxContainer>
                            </PanelContainer>
                            <Label Text="POWER" StyleClasses="LabelHeading" />
                            <PanelContainer StyleClasses="BackgroundPanelDark">
                                <BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="7">
                                    <Label Name="PowerSuppliedLabel" Text="0 kW supplied" />
                                    <Label Name="PowerAvailableLabel" Text="0 kW available" />
                                    <Label Name="OutputPercentLabel" Text="Setting: 0%" />
                                    <Label Name="PowerEfficiencyLabel" Text="Power efficiency: --" />
                                    <Label Name="CoolantFlowLabel" Text="Coolant flow: 0 mol/s" />
                                    <Label Name="HeatTransferLabel" Text="Heat removed from core: 0 kW" />
                                </BoxContainer>
                            </PanelContainer>
                            <Button Name="EjectCoreButton" Text="Eject Core" />
                        </BoxContainer>
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>

            <BoxContainer Orientation="Vertical" SeparationOverride="8" HorizontalExpand="True" VerticalExpand="True">
                <PanelContainer StyleClasses="BackgroundPanelDark" HorizontalExpand="True" VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="8">
                        <Label Text="REACTOR TEMPERATURE" StyleClasses="LabelKeyText" />
                        <BoxContainer Orientation="Horizontal" SeparationOverride="12" HorizontalExpand="True" VerticalExpand="True">
                            <PanelContainer StyleClasses="BackgroundPanelDark" HorizontalExpand="True" VerticalExpand="True">
                                <BoxContainer Orientation="Vertical" SeparationOverride="6" Margin="7">
                                    <Label Text="CORE TEMPERATURE" StyleClasses="StatusFieldTitle" HorizontalAlignment="Center" />
                                    <ui:ZpmVerticalBar Name="CoreTemperatureBar" MinValue="0" MaxValue="1500" Value="293" SetWidth="56" SetHeight="330" VerticalExpand="True" HorizontalAlignment="Center" />
                                    <Label Name="CoreTemperatureLabel" Text="--" HorizontalAlignment="Center" />
                                </BoxContainer>
                            </PanelContainer>
                            <PanelContainer StyleClasses="BackgroundPanelDark" HorizontalExpand="True" VerticalExpand="True">
                                <BoxContainer Orientation="Vertical" SeparationOverride="6" Margin="7">
                                    <Label Text="COOLANT INLET" StyleClasses="StatusFieldTitle" HorizontalAlignment="Center" />
                                    <ui:ZpmVerticalBar Name="CoolantInletBar" MinValue="0" MaxValue="600" Value="0" SetWidth="56" SetHeight="330" VerticalExpand="True" HorizontalAlignment="Center" />
                                    <Label Name="InletLabel" Text="--" HorizontalAlignment="Center" />
                                </BoxContainer>
                            </PanelContainer>
                            <PanelContainer StyleClasses="BackgroundPanelDark" HorizontalExpand="True" VerticalExpand="True">
                                <BoxContainer Orientation="Vertical" SeparationOverride="6" Margin="7">
                                    <Label Text="HEAT OUTLET" StyleClasses="StatusFieldTitle" HorizontalAlignment="Center" />
                                    <ui:ZpmVerticalBar Name="HeatOutletBar" MinValue="0" MaxValue="2000" Value="0" SetWidth="56" SetHeight="330" VerticalExpand="True" HorizontalAlignment="Center" />
                                    <Label Name="OutletLabel" Text="--" HorizontalAlignment="Center" />
                                </BoxContainer>
                            </PanelContainer>
                        </BoxContainer>
                    </BoxContainer>
                </PanelContainer>
                <PanelContainer StyleClasses="BackgroundPanelDark">
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8" Margin="8">
                        <Label Text="METER SCALE" StyleClasses="StatusFieldTitle" VerticalAlignment="Center" />
                        <Label Text="COOL (BLUE)" VerticalAlignment="Center" />
                        <Label Text="→" VerticalAlignment="Center" />
                        <Label Text="HOT (RED)" VerticalAlignment="Center" />
                        <Label Text="→" VerticalAlignment="Center" />
                        <Label Text="HOT (RED)" VerticalAlignment="Center" />
                        <BoxContainer HorizontalExpand="True" />
                        <Button Name="StartShutdownButton" Text="Start Reactor" MinWidth="150" />
                        <Button Name="EmergencyShutdownButton" Text="Emergency Shutdown" StyleClasses="ButtonColorRed" MinWidth="190" />
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</ui:ZpmConsoleWindow>
