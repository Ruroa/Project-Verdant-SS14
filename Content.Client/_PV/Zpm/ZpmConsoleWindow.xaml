<ui:ZpmConsoleWindow xmlns="https://spacestation14.io"
                     xmlns:ui="clr-namespace:Content.Client._PV.Zpm"
                     MinSize="760 500"
                     SetSize="900 560"
                     Title="ZPM Reactor Control">
    <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="10">
        <Label Name="ConnectionLabel" StyleClasses="LabelHeading" Text="No ZPM control linked" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="10" VerticalExpand="True">
            <PanelContainer SetWidth="275" VerticalExpand="True">
                <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="8">
                    <Label Text="OUTPUT SETTING" StyleClasses="LabelHeading" />
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8" VerticalExpand="True">
                        <BoxContainer Orientation="Vertical" SeparationOverride="4" VerticalAlignment="Center">
                            <Label Text="100%" HorizontalAlignment="Center" />
                            <ui:ZpmVerticalBar Name="OutputBar"
                                               MinValue="0" MaxValue="100" Value="0"
                                               Step="5" Interactive="True"
                                               SetWidth="28" SetHeight="255" />
                            <Label Text="0%" HorizontalAlignment="Center" />
                        </BoxContainer>
                        <BoxContainer Orientation="Vertical" SeparationOverride="5" HorizontalExpand="True">
                            <Label Text="STATUS" StyleClasses="LabelHeading" />
                            <PanelContainer>
                                <BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="6">
                                    <Label Name="CoreLabel" Text="Core: --" />
                                    <Label Name="ConditionLabel" Text="Condition: --" />
                                    <Label Name="IntegrityLabel" Text="Integrity: --" />
                                    <Label Name="ShieldingLabel" Text="Shielding: --" />
                                    <Label Name="VacuumLabel" Text="Chamber pressure: --" />
                                </BoxContainer>
                            </PanelContainer>
                            <Label Text="POWER" StyleClasses="LabelHeading" />
                            <PanelContainer>
                                <BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="6">
                                    <Label Name="PowerSuppliedLabel" Text="0 kW supplied" />
                                    <Label Name="PowerAvailableLabel" Text="0 kW available" />
                                    <Label Name="OutputPercentLabel" Text="Setting: 0%" />
                                    <Label Name="PowerEfficiencyLabel" Text="Efficiency: --" />
                                </BoxContainer>
                            </PanelContainer>
                            <Button Name="EjectCoreButton" Text="Eject Core" />
                        </BoxContainer>
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>

            <PanelContainer HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Orientation="Vertical" SeparationOverride="10" Margin="8">
                    <BoxContainer Orientation="Horizontal" SeparationOverride="12" HorizontalExpand="True" VerticalExpand="True">
                        <BoxContainer Orientation="Vertical" SeparationOverride="5" HorizontalExpand="True" HorizontalAlignment="Center">
                            <Label Text="CORE TEMPERATURE" HorizontalAlignment="Center" />
                            <ui:ZpmVerticalBar Name="CoreTemperatureBar" MinValue="0" MaxValue="1500" Value="293" SetWidth="48" SetHeight="270" />
                            <Label Name="CoreTemperatureLabel" Text="--" HorizontalAlignment="Center" />
                        </BoxContainer>
                        <BoxContainer Orientation="Vertical" SeparationOverride="5" HorizontalExpand="True" HorizontalAlignment="Center">
                            <Label Text="COOLANT INLET" HorizontalAlignment="Center" />
                            <ui:ZpmVerticalBar Name="CoolantInletBar" MinValue="0" MaxValue="600" Value="0" SetWidth="48" SetHeight="270" />
                            <Label Name="InletLabel" Text="--" HorizontalAlignment="Center" />
                        </BoxContainer>
                        <BoxContainer Orientation="Vertical" SeparationOverride="5" HorizontalExpand="True" HorizontalAlignment="Center">
                            <Label Text="HEAT OUTLET" HorizontalAlignment="Center" />
                            <ui:ZpmVerticalBar Name="HeatOutletBar" MinValue="0" MaxValue="2000" Value="0" SetWidth="48" SetHeight="270" />
                            <Label Name="OutletLabel" Text="--" HorizontalAlignment="Center" />
                        </BoxContainer>
                    </BoxContainer>
                    <BoxContainer Orientation="Vertical" SeparationOverride="6" HorizontalAlignment="Right" SetWidth="310">
                        <Button Name="StartShutdownButton" Text="Start Reactor" />
                        <Button Name="EmergencyShutdownButton" Text="Emergency Shutdown" StyleClasses="ButtonColorRed" />
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
    </BoxContainer>
</ui:ZpmConsoleWindow>
